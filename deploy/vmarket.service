[Unit]
Description=vMarket Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/market.venivci.com
ExecStart=/usr/bin/node /var/www/market.venivci.com/.next/standalone/server.js
Environment=PORT=3002
Environment=HOSTNAME=0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
